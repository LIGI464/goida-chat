# Local URLs. For production use real HTTPS domains.
APP_URL=http://localhost
API_URL=http://localhost
LIVEKIT_URL=ws://livekit.localhost

# Caddy site addresses. Example for production: app.example.com
APP_SITE=http://localhost
API_SITE=http://api.localhost
LIVEKIT_SITE=http://livekit.localhost

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

POSTGRES_DB=goida_chat
POSTGRES_USER=goida
POSTGRES_PASSWORD=change_me_database_password
DATABASE_URL=postgresql://goida:change_me_database_password@postgres:5432/goida_chat?schema=public
VALKEY_URL=redis://valkey:6379

# Generate unique secrets before deployment: openssl rand -base64 48
COOKIE_SECRET=change_me_cookie_secret_at_least_32_chars
BETTER_AUTH_SECRET=change_me_auth_secret_at_least_32_chars
BETTER_AUTH_URL=http://localhost

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change_me_livekit_secret_at_least_32_chars
