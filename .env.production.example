# Production URLs. Replace every example.com hostname with your real domain.
APP_URL=https://app.example.com
API_URL=https://api.example.com
LIVEKIT_URL=wss://livekit.example.com

# Caddy site addresses. Keep these as hostnames without scheme.
APP_SITE=app.example.com
API_SITE=api.example.com
LIVEKIT_SITE=livekit.example.com

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

POSTGRES_DB=goida_chat
POSTGRES_USER=goida
POSTGRES_PASSWORD=replace_with_strong_database_password
DATABASE_URL=postgresql://goida:replace_with_strong_database_password@postgres:5432/goida_chat?schema=public
VALKEY_URL=redis://valkey:6379

COOKIE_SECRET=replace_with_openssl_rand_base64_48
BETTER_AUTH_SECRET=replace_with_openssl_rand_base64_48
BETTER_AUTH_URL=https://api.example.com

LIVEKIT_API_KEY=replace_with_livekit_key
LIVEKIT_API_SECRET=replace_with_livekit_secret
