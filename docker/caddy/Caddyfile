{$APP_SITE:http://localhost} {
  handle /auth/* {
    reverse_proxy backend:3000
  }

  handle /health {
    reverse_proxy backend:3000
  }

  handle /socket.io/* {
    reverse_proxy backend:3000
  }

  handle {
    reverse_proxy frontend:80
  }
}

{$API_SITE:http://api.localhost} {
  reverse_proxy backend:3000
}

{$LIVEKIT_SITE:http://livekit.localhost} {
  reverse_proxy livekit:7880
}
