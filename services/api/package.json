{
  "name": "@goida-chat/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file ../../.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file ../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "node --env-file ../../.env ../../node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file ../../.env ../../node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file ../../.env ../../node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file ../../.env --import tsx prisma/seed.ts",
    "db:reset-chats": "node --env-file ../../.env --import tsx prisma/reset-chats.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.0.0",
    "@goida-chat/shared": "*",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "better-auth": "^1.3.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.0.0",
    "jose": "^6.0.0",
    "livekit-server-sdk": "^2.13.0",
    "socket.io": "^4.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0"
  }
}
